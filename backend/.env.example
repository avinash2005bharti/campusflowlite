# ==============================================================================
# CampusFlow Lite - Backend Environment Configuration Example
# Duplicate this file to .env and configure with your credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# 1. MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusflow?retryWrites=true&w=majority

# 2. JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_here_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_at_least_32_chars
JWT_EXPIRE=7d

# 3. Brevo (Transactional Email API for Status Updates)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME="CampusFlow Notifications"
SMTP_KEY=your_brevo_smtp_key_here

# 4. ImageKit (Cloud Storage for Proof Documents, Certificates, Images & PDFs)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/

# 5. Frontend Client URL
CLIENT_URL=http://localhost:5173
